# =============================================================================
# DeepTrace Forensics — Hybrid Vercel / Laptop Cloudflare Tunnel Environment
# =============================================================================
# SECURITY NOTICE:
# This hybrid deployment architecture (Vercel UI + Cloudflare Tunnel Laptop Server)
# is intended for demonstration, research, and non-classified forensic triage.
# DO NOT process real-world classified evidence over unauthenticated public tunnels.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CLIENT API ROUTING (Baked in at client build time)
# -----------------------------------------------------------------------------
# For direct browser -> laptop tunnel communication, set this to your active
# Cloudflare Tunnel domain (e.g. https://your-subdomain.trycloudflare.com).
# Leave blank ("") when developing entirely on localhost.
# IMPORTANT: NEXT_PUBLIC_* variables are embedded at build time; redeploy on Vercel
# whenever your trycloudflare tunnel URL changes.
NEXT_PUBLIC_API_URL=""

# -----------------------------------------------------------------------------
# 2. LAPTOP SERVER CORS ALLOWLIST (Server-side runtime only)
# -----------------------------------------------------------------------------
# Comma-separated list of permitted web origins that can send cross-origin requests
# to your laptop server via the tunnel. Never use "*".
# Example: https://deeptrackforensics.vercel.app,http://localhost:3000
ALLOWED_ORIGINS="https://deeptrackforensics.vercel.app,http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. SUPABASE PUBLIC CREDENTIALS (Client-safe)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 4. SUPABASE SERVER-ONLY CREDENTIALS (CRITICAL: NEVER PREFIX WITH NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# The service-role key bypasses PostgreSQL Row Level Security (RLS) and provides
# full administrative access to the evidence vault and audit logs.
# KEEP THIS STRICTLY SECRET ON YOUR LOCAL LAPTOP SERVER.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# 5. OPTIONAL FASTAPI BACKEND PROXY (Optional)
# -----------------------------------------------------------------------------
# Optional external Python FastAPI backend endpoint. If omitted, the native
# Node.js forensic pipeline handles all examinations directly on your laptop.
BACKEND_URL="http://127.0.0.1:8000"
